# Stage 1: Install production dependencies
FROM node:20-slim AS deps

# Install build dependencies for sharp and system tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    libvips-dev \
    pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Stage 2: Runtime
FROM node:20-slim AS runtime

# Install libvips runtime dependency
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvips42 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY backend/ ./

# Create upload directories (overridden by volume mount in production)
RUN mkdir -p public/uploads/brands public/uploads/products public/uploads/temp

EXPOSE 5000

CMD ["sh", "-c", "npx sequelize-cli db:migrate --env production && node server.js"]