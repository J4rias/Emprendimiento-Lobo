# Configuración para Empresa 1
# IMPORTANTE: Cambiar todos los valores marcados con CAMBIAR antes de usar en producción

NODE_ENV=production
PORT=5000

# Base de datos — Empresa 1 usa su propia BD en el MySQL compartido
DB_HOST=lobo-mysql
DB_PORT=3306
DB_NAME=empresa1_db
DB_USER=lobo_user
DB_PASSWORD=CAMBIAR_PASSWORD

# Seguridad — debe ser único por empresa
JWT_SECRET=CAMBIAR_JWT_SECRET_EMPRESA1_MIN_32_CHARS

# CORS — subdominio de esta empresa
FRONTEND_URL=https://empresa1.dominio.com

# Límites de rate limiting (opcional)
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=1000
